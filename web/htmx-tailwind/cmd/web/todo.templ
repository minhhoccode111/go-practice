package web

import (
	"fmt"
	"htmx-tailwind/internal/database"
)

templ TodoPage(todos []database.Todo) {
	@Base() {
		<div class="min-h-screen">
			<div class="max-w-lg mx-auto px-4 py-12 sm:py-20">
				<header class="mb-10">
					<h1 class="text-4xl font-display font-semibold tracking-tight text-slate-900">
						todo<span class="text-violet-500">.</span>
					</h1>
					<p class="text-slate-400 text-sm mt-1.5">manage your day</p>
				</header>

				<div id="todo-error"></div>

				<form
					hx-post="/todos"
					method="POST"
					hx-target="#todo-container"
					hx-swap="beforeend"
					hx-on::after-request="if(event.detail.successful) this.reset()"
				>
					<div class="flex items-center gap-2 bg-white rounded-xl border border-slate-200 has-[input:focus]:border-violet-400 has-[input:focus]:ring-2 has-[input:focus]:ring-violet-100 transition-all px-3">
						<input
							class="flex-1 py-3.5 bg-transparent text-slate-800 placeholder:text-slate-400 text-sm focus:outline-none"
							id="title"
							name="title"
							type="text"
							placeholder="What needs to be done?"
							autocomplete="off"
						/>
						<button type="submit" class="shrink-0 px-4 py-2 bg-violet-600 hover:bg-violet-700 active:bg-violet-800 text-white text-sm font-medium rounded-lg transition-colors">
							Add
						</button>
					</div>
				</form>

				<div id="todo-container" class="mt-6 space-y-1">
					for _, t := range todos {
						@TodoItem(t)
					}
				</div>

				<div id="empty-state" class="text-center py-16">
					<div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-slate-100 flex items-center justify-center">
						<svg class="w-6 h-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-3-3v6m-7 4h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
						</svg>
					</div>
					<p class="text-slate-400 text-sm">Your list is empty</p>
					<p class="text-slate-400 text-xs mt-1">Add a task to get started</p>
				</div>

				<dialog id="todo-modal" class="rounded-2xl p-0 shadow-2xl max-w-md w-[calc(100%-2rem)] fixed inset-0 m-auto"></dialog>
			</div>
		</div>
	}
}

templ TodoItem(t database.Todo) {
	<div id={ fmt.Sprintf("todo-%d", t.ID) } class={ "flex items-center gap-3 px-4 py-3.5 bg-white rounded-xl border transition-all animate-slide-up", templ.KV("border-slate-200 hover:border-violet-200 hover:shadow-sm", !t.Done), templ.KV("border-transparent opacity-60", t.Done) }>
		<button
			hx-patch={ fmt.Sprintf("/todos/%d/toggle", t.ID) }
			hx-target="closest div[id^='todo-']"
			hx-swap="outerHTML"
			class={ "shrink-0 w-5 h-5 rounded-full flex items-center justify-center transition-all", templ.KV("border-2 border-slate-300 hover:border-violet-400", !t.Done), templ.KV("bg-violet-500 text-white", t.Done) }
		>
			if t.Done {
				<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
				</svg>
			}
		</button>

		<span class={ "flex-1 text-sm", templ.KV("text-slate-800", !t.Done), templ.KV("text-slate-400 line-through", t.Done) }>
			{ t.Title }
		</span>

		<div class="flex items-center gap-0.5">
			<button
				hx-get={ fmt.Sprintf("/todos/%d/edit", t.ID) }
				hx-target="#todo-modal"
				hx-swap="innerHTML"
				hx-on::after-on-load="let m=document.getElementById('todo-modal');m.showModal();requestAnimationFrame(()=>{let i=m.querySelector('input');i&&(i.selectionStart=i.selectionEnd=i.value.length)})"
				class="p-2 text-slate-400 hover:text-violet-600 rounded-lg hover:bg-violet-50 transition-colors"
				title="Edit"
			>
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
				</svg>
			</button>
			<button
				hx-delete={ fmt.Sprintf("/todos/%d", t.ID) }
				hx-target="closest div[id^='todo-']"
				hx-swap="outerHTML"
				class="p-2 text-slate-400 hover:text-rose-500 rounded-lg hover:bg-rose-50 transition-colors"
				title="Delete"
			>
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
				</svg>
			</button>
		</div>
	</div>
}

templ TodoEditForm(t database.Todo, err string) {
	<div class="p-6">
		<h2 class="text-lg font-display font-semibold text-slate-900 mb-4">Edit task</h2>
		if err != "" {
			<p class="mb-4 px-4 py-3 bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl">{ err }</p>
		}
		<form
			hx-put={ fmt.Sprintf("/todos/%d", t.ID) }
			hx-target={ fmt.Sprintf("#todo-%d", t.ID) }
			hx-swap="outerHTML"
			hx-on::after-request="if(event.detail.successful) document.getElementById('todo-modal').close()"
			class="flex flex-col gap-4"
		>
			<input
				class="w-full px-4 py-3 bg-white rounded-xl border border-slate-200 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-violet-200 focus:border-violet-400 transition-shadow"
				name="title"
				value={ t.Title }
				autofocus
			/>
			<div class="flex gap-2 justify-end">
				<button type="button" onclick="document.getElementById('todo-modal').close()" class="px-4 py-2.5 text-sm text-slate-500 hover:text-slate-700 font-medium rounded-xl transition-colors">
					Cancel
				</button>
				<button type="submit" class="px-5 py-2.5 bg-violet-600 hover:bg-violet-700 active:bg-violet-800 text-white text-sm font-medium rounded-xl transition-colors">
					Save
				</button>
			</div>
		</form>
	</div>
}
