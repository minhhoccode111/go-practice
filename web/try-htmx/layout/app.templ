package layout

type AppData struct {
	PageTitle string
}

templ App(data AppData, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.PageTitle }</title>
		</head>
		<body>
			@content
			<script src="/assets/js/htmx.min.js"></script>
		</body>
	</html>
}
